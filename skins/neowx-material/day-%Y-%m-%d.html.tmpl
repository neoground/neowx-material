                                                    #set $cc_pos = $cc_pos + 1
                                                #else
                                                    ## Multiple columns → append column label to series name
                                                    #for $col in $cols
                                                        {
                                                            name: "$getVar('obs.label.' + val) $gettext($col)",
                                                            data: [ $getChartData(val, col) ]
                                                        },
                                                        #silent $cc_color_list.append($cc_color_refs[$cc_pos] if $cc_pos < len($cc_color_refs) else 'default')
                                                        #set $cc_pos = $cc_pos + 1
                                                    #end for
                                                #end if
                                            #else
                                                #set $cc_pos = $cc_pos + len($cols)
                                            #end if
                                        #end for
                                    ],
                                    #if len($cc_color_refs) > 0 and len($cc_color_list) > 0
                                        #set $cc_color_count = len($cc_color_list)
                                        colors: neowxChartColors([
                                        #for $cref in $cc_color_list
                                            "$cref",
                                        #end for
                                        ], $cc_color_count, "$x"),
                                    #end if
                                }).render()
                            });
                        #end if
                    #end if
                #end if
            #end for

            ## Telemetry charts on this page. The include never touches the
            ## alignment globals - a telemetry chart follows the page's window
            ## like every chart beside it - so it only has to come after
            ## graph_align_setup.inc and var graph_area_config, which it reads.
            ## This page's own data window, so a telemetry chart here fetches what the
            ## weather charts beside it fetch - not chart_days at default_interval.
            #set global $tele_chart_span     = $day
            #set global $tele_chart_interval = int($Extras.Charts.current_timespan)
            #set global $tele_mode        = 'js'
            #set global $tele_chart_items = [x for x in $panelItems('chart', page=$page, subpage=$subpage) if $isTelemetryItem(x)]
            #include "inc/telemetry.inc"

        </script>

        <script src="$Extras.MQTT.paho_mqtt_url" type="text/javascript"></script>
        <script type="text/javascript" src="${base_path}js/weewx-mqtt.js?v=$Extras.version"></script>

    </body>
