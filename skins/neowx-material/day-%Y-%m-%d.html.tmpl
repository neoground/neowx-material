                    var vec_key = false;

                    // Detect key based on vec direction (0-360). 45° steps, using the middle +- 45/2=22.5
                    if(vec_dir > 337.5 || vec_dir <= 22.5) {
                        vec_key = 'N';
                    }
                    if(vec_dir > 22.5 && vec_dir <= 67.5) {
                        vec_key = 'NE';
                    }
                    if(vec_dir > 67.5 && vec_dir <= 112.5) {
                        vec_key = 'E';
                    }
                    if(vec_dir > 112.5 && vec_dir <= 157.5) {
                        vec_key = 'SE';
